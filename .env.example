# OpenWebUI — settings (copy to .env: cp .env.example .env)
# Most users only need to change OPENWEBUI_PORT. The rest is optional.

# Port to access OpenWebUI (change if 8080 is already in use)
OPENWEBUI_PORT=8080

# Secret key for sessions — leave empty to auto-generate on first run
WEBUI_SECRET_KEY=

# Enable OpenAI-compatible API (needed to connect models)
ENABLE_OPENAI_API=true

# Optional: custom OpenAI-compatible API base URL
OPENAI_API_BASE_URL=

# Optional: your API key for OpenAI-compatible providers
OPENAI_API_KEY=
